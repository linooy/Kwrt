# XhaxhWrt x86_64 Custom Config
# 基于 common/.config 的额外包和配置
# 品牌定制
CONFIG_VERSION_DIST="Xhaxhwrt"
CONFIG_VERSION_MANUFACTURER="power by xlin"
CONFIG_VERSION_FILENAMES=n
CONFIG_VERSION_CODE_FILENAMES=n
CONFIG_VERSION_HOME_URL=""

# 固件大小（5.9G overlay → 6000MB）
CONFIG_TARGET_ROOTFS_PARTSIZE=6000

# === 代理 / VPN ===
CONFIG_PACKAGE_luci-app-passwall2=y
CONFIG_PACKAGE_xray-core=y
CONFIG_PACKAGE_sing-box=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y
CONFIG_PACKAGE_shadowsocks-libev-ss-local=y
CONFIG_PACKAGE_shadowsocks-rust-sslocal=y
CONFIG_PACKAGE_shadowsocksr-libev-ssr-local=y
CONFIG_PACKAGE_simple-obfs-client=y
CONFIG_PACKAGE_v2ray-plugin=y
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y

# === 证书 / DDNS ===
CONFIG_PACKAGE_luci-app-acme=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_ddns-scripts-cloudflare=y
CONFIG_PACKAGE_ddns-scripts-dnspod-v3=y

# === Docker ===
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_containerd=y
CONFIG_PACKAGE_runc=y
CONFIG_PACKAGE_docker-compose=y
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_tini=y
CONFIG_PACKAGE_fuse-overlayfs=y

# === UPS / NUT ===
CONFIG_PACKAGE_luci-app-nut=y
CONFIG_PACKAGE_nut=y
CONFIG_PACKAGE_nut-driver-usbhid-ups=y

# === 监控 / 统计 ===
CONFIG_PACKAGE_luci-app-statistics=y
CONFIG_PACKAGE_collectd=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_nlbwmon=y

# === 应用过滤 ===
CONFIG_PACKAGE_luci-app-oaf=y

# === 系统工具 ===
CONFIG_PACKAGE_luci-app-arpbind=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-app-log-viewer=y
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_luci-app-webadmin=y
CONFIG_PACKAGE_luci-app-netspeedtest=y
CONFIG_PACKAGE_netspeedtest=y
CONFIG_PACKAGE_smartmontools=y
CONFIG_PACKAGE_lm-sensors=y
CONFIG_PACKAGE_lm-sensors-detect=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_tcping=y
CONFIG_PACKAGE_socat=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_speedtest-cli=y

# === 存储 / 文件系统 ===
CONFIG_PACKAGE_btrfs-progs=y
CONFIG_PACKAGE_kmod-fs-btrfs=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_ntfs3-mount=y
CONFIG_PACKAGE_exfat-fsck=y
CONFIG_PACKAGE_exfat-mkfs=y
CONFIG_PACKAGE_automount=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_partx-utils=y

# === 网络工具 ===
CONFIG_PACKAGE_bind-host=y
CONFIG_PACKAGE_haproxy=y
CONFIG_PACKAGE_geoview=y
CONFIG_PACKAGE_homebox=y

# === 语言包 ===
CONFIG_PACKAGE_luci-i18n-passwall2-zh-cn=y
CONFIG_PACKAGE_luci-i18n-acme-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y
CONFIG_PACKAGE_luci-i18n-dockerman-zh-cn=y
CONFIG_PACKAGE_luci-i18n-nut-zh-cn=y
CONFIG_PACKAGE_luci-i18n-statistics-zh-cn=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y
CONFIG_PACKAGE_luci-i18n-oaf-zh-cn=y

# === 主题 ===
CONFIG_PACKAGE_luci-theme-argon=y
